{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cersanit.vercel.app"
        }
      ],
      "destination": "https://plitki-spb.ru/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cersanit.vercel.app"
        }
      ],
      "destination": "https://plitki-spb.ru/:path*",
      "statusCode": 301
    }
  ]
}
